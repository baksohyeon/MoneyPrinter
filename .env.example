# See docs/configuration.md for more information.

# Necessary API Keys
# -------------------

# TikTok Session ID
# Obtain your session ID by logging into TikTok and copying the sessionid cookie.
TIKTOK_SESSION_ID=""

# ImageMagick Binary Path
# Download ImageMagick from https://imagemagick.org/script/download.php
# Leave empty to auto-detect from PATH.
IMAGEMAGICK_BINARY=""

# Pexels API Key
# Register at https://www.pexels.com/api/ to get your API key.
PEXELS_API_KEY=""

# Optional API Keys
# -----------------

# Ollama API Base URL
# Local default: http://localhost:11434
# Docker backend + host Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama Model
# Fallback model if frontend did not send a value.
# Pull a model first: ollama pull llama3.1:8b
OLLAMA_MODEL="llama3.1:8b"

# AssemblyAI API Key
# Sign up at https://www.assemblyai.com/ to receive an API key.
ASSEMBLY_AI_API_KEY=""

# Database
# Leave DATABASE_URL empty for local SQLite default.
# In Docker Compose, empty DATABASE_URL uses postgres service fallback.
POSTGRES_DB="moneyprinter"
POSTGRES_USER="moneyprinter"
POSTGRES_PASSWORD="moneyprinter"
DATABASE_URL=""

# Encoder selection
# -----------------
# Auto-detected by default (videotoolbox on Apple Silicon, libx264 elsewhere).
# Override with: libx264 | videotoolbox
ENCODER_PROVIDER=""

# Target bitrate for the hardware (videotoolbox) encoder.
# Software libx264 ignores this and uses CRF 23.
TARGET_BITRATE="8M"

# Parallelism
# -----------
# Concurrency for the I/O-bound stages. Lower these on rate-limited APIs.
PARALLEL_SEARCH_WORKERS="8"
PARALLEL_DOWNLOAD_WORKERS="8"
PARALLEL_TTS_WORKERS="4"

# Stock video sources
# -------------------
# Comma-separated priority order. Empty = try all known providers; only those
# with API keys set are actually enabled.
STOCK_SOURCES="pexels,pixabay,coverr"

# Pixabay video API key (optional). https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# Coverr API key (optional). https://api.coverr.co/docs/auth/
COVERR_API_KEY=""

# Stock cache
# -----------
# Override cache root (default: ~/Library/Caches/moneyprinter on macOS).
STOCK_CACHE_DIR=""

# Search-result TTL (downloaded clips are cached without TTL).
STOCK_CACHE_SEARCH_TTL_DAYS="7"

# Subtitles
# ---------
# Auto-prioritized: AssemblyAI (if key set) → mlx-whisper (Mac) → local timing.
# Override with: assemblyai | mlx_whisper | local
SUBTITLES_PROVIDER=""

# mlx-whisper model. Short alias (tiny|base|small|medium|large) or full HF repo.
# Tiny is fast and accurate enough for clean TTS narration.
MLX_WHISPER_MODEL="tiny"

# Image generation (B-roll for stock gaps)
# ----------------------------------------
# Off by default. Enable to let the pipeline fill terms with no stock match
# by generating an AI image and animating it with Ken-Burns motion.
# Apple Silicon only via mflux (FLUX Schnell). Heavy: ~12GB model download
# and 20-50s per image at 1024x1792.
IMAGEGEN_ENABLED="false"

# Override provider explicitly (sets IMAGEGEN_ENABLED implicitly).
IMAGEGEN_PROVIDER=""

# mflux model alias: schnell (fast, 2-4 steps) | dev (slower, ~20 steps).
MFLUX_MODEL="schnell"

# 4 = 4-bit quantization (~12GB, recommended). 8 or "none" trade VRAM for fidelity.
MFLUX_QUANTIZE="4"

# Override inference steps (default: 4 for schnell, 20 for dev).
MFLUX_STEPS=""

# Intro asset
# -----------
# If assets/intro.{png,jpg,jpeg,webp} exists it is auto-prepended to every
# video as the first clip with Ken-Burns motion="fit" (no crop, white
# letterbox). Delete the file to disable. INTRO_DURATION controls length.
INTRO_DURATION="3.0"


